pipeline {
    agent {
        docker { 
            image 'node:16-alpine' 
            args '--user root' // Allow Docker container to run as root for necessary permissions
        }
    }
    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }
        stage('Create HelloWorld.java') {
            steps {
                script {
                    sh '''
                        echo 'public class HelloWorld {
                            public static void main(String[] args) {
                                System.out.println("Hello, World!");
                            }
                        }' > HelloWorld.java
                    '''
                }
            }
        }
        stage('Compile Java') {
            steps {
                script {
                    sh 'javac HelloWorld.java'
                }
            }
        }
        stage('Run Java Program') {
            steps {
                script {
                    sh 'java HelloWorld'
                }
            }
        }
    }
}
